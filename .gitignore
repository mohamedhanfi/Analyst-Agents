# secrets — never committed
.env

# python
__pycache__/
*.pyc
*.egg-info/

# run isolation — only run outputs are ignored; template is tracked
runs/*
!runs/.gitkeep
!runs/_template/

# flow review web tool — runtime data only
tests/Flow_review/runs/
tests/Flow_review/uploads/

# cache (idempotency + run index)
cache/*
!cache/.gitkeep